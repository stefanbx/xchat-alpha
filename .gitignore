# build artifacts
app/build/
app/.dart_tool/
app/.gradle/
**/__pycache__/
# secrets / local state — never commit.
# The signing keys live in ~/.xchat and are only referenced from here; these patterns are the
# backstop for the day someone copies one into the tree "just for a second".
*.jks
*.keystore
*.p12
key.properties
publisher.key
relay/*.json
*-state.json
/tmp/

# staged for the container image by deploy/deploy.sh
deploy/app/
deploy/relay/app/

# compiled GPU work generator — built by the installer (or: cc -O3 relay/work/nano_work_cl.c
# -o relay/work/nano_work_cl -framework OpenCL). The SOURCE is tracked; the binary is not.
relay/work/nano_work_cl
