import "kt_wallet.kl"
fn main() {
  let sk = hex_to_list(arg(1))
  let prev = hex_to_list(arg(2))
  let reppub = hex_to_list(arg(3))
  let bal16 = zeros(16)  bal_encode(arg(4), bal16)
  let link = hex_to_list(arg(5))
  let pub = ed_pubkey(sk)
  let hash = block_hash(pub, prev, reppub, bal16, link)
  let sig = ed_sign(sk, hash)
  print("hash " + list_hex(hash, 32))
  print("sig " + list_hex(sig, 64))
  print("account " + addr_encode(pub))
  print("rep " + addr_encode(reppub))
}
